# Подключение к базе. Хост — имя сервиса из docker-compose, НЕ localhost.
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres_db:5432/my_service_db

# Внешние API (на первой лекции — заглушки, реально не вызываются)
API_URL=http://external-api/api/tasks/unprocessed
RESULT_URL=http://external-api/api/tasks/process-result
