# Подключение к базе. Хост — имя сервиса из docker-compose, НЕ localhost.
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres_db:5432/my_service_db

# Источник задач для POST /tasks/import и приёмник результатов для экспорта
API_URL=https://jsonplaceholder.typicode.com/posts/1/comments
RESULT_URL=http://external-api/api/tasks/process-result

OPENAI_API_KEY=
MODEL=gpt-4o-mini
PROMPT=Определи тональность отзыва. Ответь строго одним словом: positive, negative или neutral.
TEST_MODE=false
MAX_ATTEMPTS=3
POLL_INTERVAL=5
STUCK_MINUTES=5
RUN_WORKER=true
